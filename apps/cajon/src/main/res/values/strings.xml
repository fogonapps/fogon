  <string name="acerca_de_corto">About</string>
  <string name="tmdb_explica">To search films, series and anime, El Cajón uses TMDB, the largest open film database. TMDB asks each person to use their own key: it’s free and you only get it once.</string>
  <string name="tmdb_pasos">1. Create a free account at themoviedb.org.\n2. In Settings → API, request a key (personal use).\n3. Copy the “API Key” (or the “API Read Access Token”) and paste it here.</string>
  <string name="abrir_tmdb">Open TMDB</string>
  <string name="pega_clave">Paste your key here</string>
  <string name="quitar_clave">Remove key</string>
  <string name="tmdb_privacidad">The key stays encrypted on this phone and is only used to search. It isn’t in backups or sync.</string>
  <string name="tmdb_aviso">El Cajón uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.</string>
  <string name="sync_explica">Connect your GitHub and your cajón saves itself to a private file in your account (a secret Gist). El Cajón on your PC reads that same file, so you have the same on both. It’s optional.</string>
  <string name="sync_pasos">1. Tap Create token (GitHub opens with everything ready).\n2. Under Expiration choose No expiration or 1 year.\n3. Scroll down, tap Generate token, copy it and paste it here.</string>
  <string name="crear_token">Create token</string>
  <string name="pega_token">Paste your token here (ghp_…)</string>
  <string name="conectar">Connect</string>
  <string name="sync_sincronizando">Syncing…</string>
  <string name="sync_ultima">Last synced: %1$s</string>
  <string name="sincronizar_ahora">Sync now</string>
  <string name="desconectar">Disconnect</string>
  <string name="desconectar_pregunta">Disconnect GitHub?</string>
  <string name="desconectar_texto">What’s on this phone stays. The file on your GitHub stays too (delete it there if you want).</string>
  <string name="sync_privacidad">The token stays encrypted on this phone. The file is secret: only someone with its link or your account can see it.</string>
  <string name="sync_token_vencido">The token is invalid or expired.</string>
  <string name="sync_sin_permiso">The token has no gist permission.</string>
  <string name="sync_sin_conexion">Couldn’t reach GitHub.</string>
