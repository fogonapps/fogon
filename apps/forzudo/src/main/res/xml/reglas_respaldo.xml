<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sin copias automáticas a la nube de Google. Al pasar a un teléfono nuevo (cable o Wi-Fi) sí se copian los entrenos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
